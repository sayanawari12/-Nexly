# ========================================================
# PROJECT APEX - Local Environment Variables Example
# ========================================================
#
# Copy this file to a new file named `.env` in the root directory
# and populate the variables below.
#
# Do NOT commit your actual `.env` file to source control.

# --------------------------------------------------------
# 1. Judge0 API Configuration
# --------------------------------------------------------

# Option A: RapidAPI (Default)
# Set your RapidAPI host and key.
REACT_APP_JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
REACT_APP_JUDGE0_API_KEY=your_rapidapi_key_here

# Option B: Self-Hosted / Local Instance
# Uncomment and modify the lines below if running a local Judge0 docker instance.
# REACT_APP_JUDGE0_API_HOST=http://localhost:2358
# REACT_APP_JUDGE0_API_KEY=your_optional_auth_token_or_leave_empty
