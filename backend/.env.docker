# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL (Docker Service Name)
DATABASE_URL=postgresql://apex_user:apex_password@postgres:5432/apex_db?schema=public

# Redis (Docker Service Name)
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=your_32_characters_long_jwt_access_secret_key
JWT_REFRESH_SECRET=your_32_characters_long_jwt_refresh_secret_key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Admin
ADMIN_EMAIL=admin@apex.domain
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123