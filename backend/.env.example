# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://apex_user:apex_password@localhost:5433/apex_db?schema=public

# Redis Configuration (BullMQ / Rate Limiting / Cache)
REDIS_URL=redis://localhost:6380

# JWT Configurations (Secrets must be at least 32 characters)
JWT_ACCESS_SECRET=your_32_characters_long_jwt_access_secret_key
JWT_REFRESH_SECRET=your_32_characters_long_jwt_refresh_secret_key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Default Development Admin Account Setup (Documented local credentials, do not expose secrets in production)
ADMIN_EMAIL=admin@apex.domain
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
